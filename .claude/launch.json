{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "saju-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AI_PROVIDERS=none",
        "SAJU_DB=.tmp/test.db",
        "PORT=8765",
        "PYTHONUNBUFFERED=1",
        "python3",
        "saju/server.py"
      ],
      "port": 8765
    },
    {
      "name": "samgam-morning",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "samgam-morning"
      ],
      "port": 8790
    }
  ]
}