# 비밀 — 절대 올리지 않음
.env
credentials.json
token.json
token_finance.json

# 임시 작업 공간
.tmp/*
!.tmp/.gitkeep

# 파이썬
.venv/
__pycache__/
node_modules/

# 사주 서비스 데이터·비밀
saju/data/
saju/.env

# 맥 시스템 파일
.DS_Store

# 영상 공장: 완성 영상과 편별 소리·그림 파일 (용량 큼). 대본(episode.json)·조사(research.md)는 보관
video/out/
video/public/episodes/**/*.wav
video/public/episodes/**/*.mp3
video/public/episodes/**/*.mp4
video/public/episodes/**/*.png
video/public/episodes/**/*.jpg

# 받아쓰기 프로그램·모델 (용량 큼, 다시 설치 가능)
video/whisper/
video/public/music/*.mp3

# 유튜브 오디오 보관함 효과음 (1.5GB, tools/sfx_download.mjs 로 다시 받을 수 있음). 목록 index.json 만 보관
video/sfx/**
!video/sfx/*/
!video/sfx/index.json
.playwright-mcp/

# 떡상 소싱 앱 보관함 (분석·대본)
tools/viral/data/

# 명함 결과물(다시 뽑을 수 있음, 연락처 포함)·받은 글꼴(24MB)
business/card/
business/fonts/

# A/B 테스트용 썸네일·제목 (다시 만들 수 있음)
AB테스트/
